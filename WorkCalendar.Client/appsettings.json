{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServerAdress": "http://localhost:5086/api/",
  "HttpClientSettings": {
    "TimeoutSeconds": 120,
    "RetryCount": 3
  },
  "Performance": {
    "EnableCompression": true,
    "CacheDurationMinutes": 30
  }
}