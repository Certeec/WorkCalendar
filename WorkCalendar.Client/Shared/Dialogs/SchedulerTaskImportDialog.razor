@using MudBlazor
@using System.IO
@using Models.Enums
@using WorkCalendar.Client.Data.Scheduler

<MudDialog>
    <DialogContent>
        @if (!isReviewing)
        {
            <MudFileUpload T="IBrowserFile" FilesChanged="OnFileUploaded">
            <ActivatorContent>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">
                    Upload Excel file
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>

        @if (fileName != null)
        {
            <MudText Typo="Typo.body2" Class="mt-2">Selected file: @fileName</MudText>
        }

        <MudSelect T="string" Label="Employee" @bind-Value="selectedName" Disabled="@(!availableNames.Any())" Class="mt-4">
            @foreach (var name in availableNames)
            {
                <MudSelectItem Value="@name">@name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="SchedulerTaskState" Label="Tasks status" @bind-Value="selectedState" Class="mt-4">
            <MudSelectItem Value="SchedulerTaskState.Planned">Planned</MudSelectItem>
            <MudSelectItem Value="SchedulerTaskState.Done">Done</MudSelectItem>
            <MudSelectItem Value="SchedulerTaskState.Availabe">Availabe</MudSelectItem>
        </MudSelect>

        <MudCheckBox @bind-Value="simplifyPlaceNames" Label="Simplify location names" Class="mt-4" />
        
        @if (isProcessing)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mt-4" />
        }
        }
        else
        {
            <MudText Typo="Typo.subtitle1" Class="mb-2">Review tasks to import (@parsedTasks?.Count):</MudText>
            <div style="max-height: 300px; overflow-y: auto; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px; padding: 8px;">
                @if (parsedTasks != null && parsedTasks.Any())
                {
                    @foreach (var t in parsedTasks.OrderBy(x => x.DateStart))
                    {
                        <MudText Typo="Typo.body2">
                            <b>@t.DateStart.ToString("dd.MM.yyyy")</b>: @t.DateStart.ToString("HH:mm") - @t.DateEnd.ToString("HH:mm") 
                            <span style="color: var(--mud-palette-text-secondary);">(@t.Place)</span>
                        </MudText>
                    }
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Error">No tasks found for this employee.</MudText>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (!isReviewing)
        {
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Color="Color.Primary" OnClick="PrepareImport" Disabled="@(string.IsNullOrEmpty(selectedName) || fileData == null)">Next</MudButton>
        }
        else
        {
            <MudButton OnClick="() => isReviewing = false">Back</MudButton>
            <MudButton Color="Color.Success" OnClick="ConfirmImport" Disabled="@(parsedTasks == null || !parsedTasks.Any())">Confirm Import</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    private string? fileName;
    private byte[]? fileData;
    private List<string> availableNames = new();
    private string selectedName = "";
    private SchedulerTaskState selectedState = SchedulerTaskState.Planned;
    private bool simplifyPlaceNames = true;
    private bool isProcessing = false;
    private bool isReviewing = false;
    private List<SchedulerTask>? parsedTasks;

    private async Task OnFileUploaded(IBrowserFile file)
    {
        if (file == null) return;
        
        isProcessing = true;
        StateHasChanged();

        fileName = file.Name;
        
        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
        fileData = ms.ToArray();

        try
        {
            using var stream = new MemoryStream(fileData);
            availableNames = SchedulerExcelImporter.GetEmployeeNames(stream);
            if (availableNames.Any())
            {
                selectedName = availableNames.First();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reading Excel file: {ex.Message}");
            availableNames.Clear();
        }

        isProcessing = false;
        StateHasChanged();
    }

    private void PrepareImport()
    {
        if (fileData == null || string.IsNullOrEmpty(selectedName)) return;

        try
        {
            using var stream = new MemoryStream(fileData);
            parsedTasks = SchedulerExcelImporter.ParseTasks(stream, selectedName, simplifyPlaceNames, selectedState);
            isReviewing = true;
        }
        catch(Exception ex)
        {
            Console.WriteLine($"Error parsing tasks: {ex.Message}");
            MudDialog.Cancel();
        }
    }

    private void ConfirmImport()
    {
        MudDialog.Close(DialogResult.Ok(parsedTasks));
    }

    private void Cancel() => MudDialog.Cancel();

    public static async Task<List<SchedulerTask>?> OpenImportDialog(IDialogService dialogService)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var result = await dialogService.ShowAsync<SchedulerTaskImportDialog>("Import from Excel", options);
        var dialogResult = await result.Result;

        if (!dialogResult.Canceled && dialogResult.Data is List<SchedulerTask> tasks)
        {
            return tasks;
        }

        return null;
    }
}
