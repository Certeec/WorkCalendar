@page "/"
@attribute [AllowAnonymous]
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8 mb-16">

    <MudGrid Class="d-flex align-center justify-center text-center mt-12 mb-16">
        <MudItem xs="12" md="8">
            <MudIcon Icon="@Icons.Material.Rounded.EditCalendar" Color="Color.Primary" Style="font-size: 5rem;" Class="mb-4" />

            <MudText Typo="Typo.h2" Color="Color.Primary" Class="font-weight-black mb-4" Style="letter-spacing: -1px;">
                Take Control of Your Work Schedule
            </MudText>

            <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mb-8 px-md-16" Style="font-weight: 400; line-height: 1.6;">
                Manage your shifts, easily analyze your income, and track your daily tasks in one smart application.
            </MudText>

            <div class="d-flex justify-center flex-wrap gap-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="rounded-pill px-8 py-3 font-weight-bold" OnClick="@(() => NavigationManager.NavigateTo("/register"))">
                    Get Started for Free
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" Class="rounded-pill px-8 py-3 font-weight-bold" OnClick="@(() => NavigationManager.NavigateTo("/login"))">
                    Sign In
                </MudButton>
            </div>
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-16" />

    <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary" Class="font-weight-bold mb-12">
        Why choose WorkCal?
    </MudText>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-8 text-center rounded-xl transition-fade" Style="background-color: #f0f9ff; height: 100%;">
                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Large" Class="mb-6" Style="width: 72px; height: 72px;">
                    <MudIcon Icon="@Icons.Material.Rounded.Event" Size="Size.Large" />
                </MudAvatar>
                <MudText Typo="Typo.h5" Class="font-weight-bold mb-3">Smart Calendar</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">Easily plan your shifts, set working hours, and get a clear overview of your entire month at a glance.</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-8 text-center rounded-xl transition-fade" Style="background-color: #f0f9ff; height: 100%;">
                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Large" Class="mb-6" Style="width: 72px; height: 72px;">
                    <MudIcon Icon="@Icons.Material.Rounded.Insights" Size="Size.Large" />
                </MudAvatar>
                <MudText Typo="Typo.h5" Class="font-weight-bold mb-3">Income Analyzer</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">Automatically calculate your regular pay, bonuses, and working hours based on your configured rates.</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-8 text-center rounded-xl transition-fade" Style="background-color: #f0f9ff; height: 100%;">
                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Large" Class="mb-6" Style="width: 72px; height: 72px;">
                    <MudIcon Icon="@Icons.Material.Rounded.BusinessCenter" Size="Size.Large" />
                </MudAvatar>
                <MudText Typo="Typo.h5" Class="font-weight-bold mb-3">Multiple Workplaces</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">Filter your schedule by different jobs and locations to keep your professional life perfectly organized.</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

</MudContainer>