@page "/UserAccountSettings"
@using Models.DatabaseModels
@using WorkCalendar.Client.Data.MessageBox
@inject NavigationManager navigationManager
@inject IUserActions userActions
@inject IMessageBoxHandler messageHandler
@inject IUserLogsActions userLogsActions

@using System.Net.Http.Json
@inject HttpClient httpClient

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-16">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="font-weight-bold mb-2">Main Dashboard</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-8">Welcome! Choose a module to work on or check your account activity.</MudText>

    <MudGrid>
        <MudItem xs="12" md="7" lg="8">
            <MudText Typo="Typo.h6" Class="mb-4 font-weight-bold">Your Tools</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudCard Elevation="2" Class="pa-2 rounded-lg transition-fade mud-ripple" Style="cursor:pointer; height: 100%;">
                        <MudCardContent>
                            <MudIcon Icon="@Icons.Material.Rounded.Analytics" Color="Color.Primary" Size="Size.Large" Class="mb-3" />
                            <MudText Typo="Typo.h6" Class="font-weight-bold">Analyzer</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Review statistics and summaries of your tasks.</MudText>
                        </MudCardContent>
                        <MudCardActions Class="pt-0">
                            <MudButton Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Rounded.ArrowForward" @onclick="@(() => NavigateTo("/WorkScheduler/SchedulerAnalyzer"))" >Open</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudCard Elevation="2" Class="pa-2 rounded-lg transition-fade mud-ripple" Style="cursor:pointer; height: 100%;">
                        <MudCardContent>
                            <MudIcon Icon="@Icons.Material.Rounded.CalendarMonth" Color="Color.Info" Size="Size.Large" Class="mb-3" />
                            <MudText Typo="Typo.h6" Class="font-weight-bold">Calendar</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Manage your work schedule on a monthly basis.</MudText>
                        </MudCardContent>
                        <MudCardActions Class="pt-0">
                            <MudButton Variant="Variant.Text" Color="Color.Info" EndIcon="@Icons.Material.Rounded.ArrowForward" @onclick="@(() => NavigateTo("/WorkScheduler/Calendar"))">Open</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudItem>

        <MudItem xs="12" md="5" lg="4">
            <MudText Typo="Typo.h6" Class="mb-4 font-weight-bold">Recent Logins</MudText>
            <MudPaper Elevation="2" Class="pa-4 rounded-lg h-100">
                <MudTable Items="@Elements.Take(4)" Elevation="0" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh><MudText Typo="Typo.caption" Class="font-weight-bold">DATE</MudText></MudTh>
                        <MudTh><MudText Typo="Typo.caption" Class="font-weight-bold">TIME</MudText></MudTh>
                        <MudTh><MudText Typo="Typo.caption" Class="font-weight-bold">IP</MudText></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date">
                            <MudText Typo="Typo.body2" Class="font-weight-bold">@context.LoginDate.ToString("yyyy-MM-dd")</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.LoginDate.ToString("HH:mm")</MudText>
                        </MudTd>
                        <MudTd DataLabel="Duration">@context.Duration</MudTd>
                        <MudTd DataLabel="IP">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">@context.UserIp</MudChip>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">No login history found.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private IEnumerable<UserLogInHistory> Elements = new List<UserLogInHistory>();

    protected override async Task OnInitializedAsync()
    {
        var result = await userLogsActions.GetUserLogInHistory();
        Elements = result.OrderByDescending(n => n.LoginDate);
    }

    private void NavigateTo(string name)
    {
        navigationManager.NavigateTo(name);
    }
}